# MCP Grid Backend Configuration
# Copy this file to .env and fill in your API keys
# -----------------------------------

# AI Provider (openai / anthropic / groq / ollama)
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Ollama (local fallback)
OLLAMA_BASE_URL=http://localhost:11434

# ElevenLabs TTS (optional - for TRON voice)
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=your-tron-voice-id

# Picovoice Wake Word (optional)
PICOVOICE_ACCESS_KEY=your-picovoice-key-here

# Server
MCP_PORT=1337
MCP_HOST=0.0.0.0

# Phase (1-4)
MCP_PHASE=1
