# MCP Grid Desktop Assistant - Configuration
# Copy this to .env and fill in your API keys

# AI Provider (at least one required)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Optional: Default AI provider (openai or anthropic)
# If not set, uses whichever key is available (prefers OpenAI)
# AI_PROVIDER=openai
